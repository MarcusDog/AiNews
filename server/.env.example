# 服务器配置
PORT=3002
NODE_ENV=development
AYA_SOURCE_PROXY_URL=
AYA_SOURCE_NETWORK_MODE=direct-only
AYA_SOURCE_TIMEOUT_MS=15000
AYA_SOURCE_RETRIES=2

# API配置
# NewsAPI密钥（可选）
NEWSAPI_KEY=your_newsapi_key_here

# OpenAI API密钥（可选，用于内容分析）
OPENAI_API_KEY=your_openai_api_key_here

# Skill 页面总览 Agent（只在服务端配置，严禁使用 REACT_APP_ 前缀）
MINIMAX_API_KEY=replace_with_a_new_server_side_key
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.5
# 可选：独立部署时显式指定 AyaNewsSkill 的 SKILL.md 或其所在目录
AYA_NEWS_SKILL_PATH=../skills/aya-news-skill/SKILL.md

# 独立管理后台（/admin）。请生成一段至少 32 位的随机值，只配置在服务端。
ADMIN_API_KEY=replace_with_a_long_random_admin_key

# Signal / Topic 数据库（默认使用 server/data/ainews.db）
AINEWS_DB_PATH=./data/ainews.db

# Creator Intelligence 观察名单。复制 example 后由运营者审核，实际名单已被 Git 忽略。
AYA_CREATOR_SEEDS_PATH=./config/creatorBenchmarks.json

# L1 公开来源配置。GitHub Token 可选；不配置时使用匿名额度。
GITHUB_TOKEN=
MASTODON_INSTANCES=https://mastodon.social
REDDIT_COMMUNITIES=LocalLLaMA,MachineLearning,artificial

# L2 官方 API（可选；空值会显示“未配置”，不会发起请求）
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
DOUYIN_ACCESS_TOKEN=
DOUYIN_OPEN_ID=

# YouTube WebSub：Secret 只存服务端环境；SHA-1 兼容默认关闭。
AYA_PUBLIC_BASE_URL=https://ainews.xiaotianaya.com
AYA_YOUTUBE_WEBSUB_SECRET=
AYA_YOUTUBE_WEBSUB_ALLOW_SHA1=0

# L3 自托管桥接（可选；必须是 HTTPS）
RSSHUB_BASE_URL=
NEWSNOW_BASE_URL=
SIGNAL_BRIDGES_JSON=[]
# 仅在可信内网确有需要时允许 Bridge 访问私网地址；生产环境不建议开启。
SIGNAL_BRIDGES_ALLOW_PRIVATE=0

# Creator Sidecar 签名摄取（可选，默认关闭）。这里只维护来源、适配器与已人工核验账号绑定；
# secretEnv 只写环境变量名，禁止在 JSON 或仓库中写入密钥值。
# 支持适配器：rsshub、newsnow、mediacrawler、xiaohongshu-mcp、douyin-parser。
AYA_CREATOR_BRIDGES_JSON=[]
# 例：AYA_CREATOR_BRIDGE_XHS_SECRET=（使用随机高强度值，通过部署平台注入）
AYA_CREATOR_BRIDGE_XHS_SECRET=

# 采集并发。SOURCE_LIMIT 只用于人工探测/测试，正常生产请留空。
AINEWS_SIGNAL_CONCURRENCY=4
AINEWS_SIGNAL_SOURCE_LIMIT=

# 测试/维护开关；生产环境通常均为 0。
AINEWS_DISABLE_CRON=0
AINEWS_SKIP_STARTUP_REFRESH=0
AYA_DISABLE_CREATOR_SCHEDULER=0
AYA_CREATOR_CONCURRENCY=4
AYA_CREATOR_REQUEST_BUDGET=100
AYA_DAILY_REPORT=./logs/daily-refresh-latest.json
# 设为 1 时，只要任一阶段 degraded 就让人工 refresh 命令返回非零；内置 cron 始终记录并继续下一轮。
AYA_DAILY_FAIL_ON_DEGRADED=0

# Creator Intelligence 实时投递。Webhook 仅允许 HTTPS 443；确有需要时用逗号列出额外端口。
# endpoint.secretRef 使用 env:变量名间接引用签名密钥，密钥值不进入数据库和 API 响应。
AYA_WEBHOOK_ALLOWED_PORTS=
AYA_CREATOR_WEBHOOK_DEFAULT_SECRET=
# 以下消息通道均为可选；留空时会明确显示 unconfigured 且不会发起网络请求。
AYA_FEISHU_WEBHOOK_URL=
AYA_WECOM_WEBHOOK_URL=
AYA_DINGTALK_WEBHOOK_URL=
AYA_TELEGRAM_WEBHOOK_URL=
AYA_NTFY_WEBHOOK_URL=
AYA_BARK_WEBHOOK_URL=

# Creator 数据维护产物必须限定在独立目录。目录应由服务账号可写，不应位于前端静态目录。
AYA_CREATOR_BACKUP_DIR=./data/backups
AYA_CREATOR_EXPORT_DIR=./data/exports

# ArXiv API（免费，无需密钥）
ARXIV_ENABLED=true

# RSS源配置
RSS_TIMEOUT=10000

# 缓存配置
CACHE_ENABLED=false
CACHE_DURATION=3600000

# 安全配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# 更新配置
UPDATE_INTERVAL=3600000
MAX_ARTICLES_PER_SOURCE=100

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/ainews.log
