# 服务器配置
PORT=3002
NODE_ENV=production

# API配置
# NewsAPI密钥
NEWSAPI_KEY=fae1e349d73345b2a5b8ead577c69b94

# OpenAI API密钥（可选，用于内容分析）
OPENAI_API_KEY=your_openai_api_key_here

# ArXiv API（免费，无需密钥）
ARXIV_ENABLED=true

# RSS源配置
RSS_TIMEOUT=10000

# 缓存配置
CACHE_ENABLED=true
CACHE_DURATION=3600000

# 安全配置 - 包含 Docker 容器和常用开发地址
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://ainews-client:3003,http://ainews-server:3002

# 更新配置
UPDATE_INTERVAL=3600000
MAX_ARTICLES_PER_SOURCE=100

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/ainews.log

# 数据库配置
DB_PATH=./data/ainews.db