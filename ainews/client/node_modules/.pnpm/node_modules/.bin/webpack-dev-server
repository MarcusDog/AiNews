#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/root/website/ainews/client/node_modules/.pnpm/webpack-dev-server@4.15.2_webpack@5.109.2_postcss@8.5.26_/node_modules/webpack-dev-server/node_modules:/root/website/ainews/client/node_modules/.pnpm/webpack-dev-server@4.15.2_webpack@5.109.2_postcss@8.5.26_/node_modules:/root/website/ainews/client/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/root/website/ainews/client/node_modules/.pnpm/webpack-dev-server@4.15.2_webpack@5.109.2_postcss@8.5.26_/node_modules/webpack-dev-server/node_modules:/root/website/ainews/client/node_modules/.pnpm/webpack-dev-server@4.15.2_webpack@5.109.2_postcss@8.5.26_/node_modules:/root/website/ainews/client/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../webpack-dev-server/bin/webpack-dev-server.js" "$@"
else
  exec node  "$basedir/../webpack-dev-server/bin/webpack-dev-server.js" "$@"
fi
